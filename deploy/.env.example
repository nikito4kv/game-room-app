# Скопировать в deploy/.env и заполнить. Файл .env в git не коммитится.

# Адреса. У всех трёх должна быть A-запись на публичный IP сервера.
APP_DOMAIN=example.com
RTC_DOMAIN=rtc.example.com
TURN_DOMAIN=turn.example.com

# Секрет API LiveKit (им же подписываются вебхуки). Сгенерировать:
#   openssl rand -hex 32
LIVEKIT_API_SECRET=

# Токен между сайтом и Redis (HTTP-обёрткой). Сгенерировать так же.
SRH_TOKEN=

# Порт TURN/UDP: 3478 или 443 (deploy/README.md, «TURN/UDP на 443»).
TURN_UDP_PORT=3478

# Пропуск во внутренний API /api/internal/* (по желанию). Не короче 32 символов,
# иначе внутренний API выключен. Сгенерировать: openssl rand -hex 32
INTERNAL_API_TOKEN=

# Необязательное: аналитика и мониторинг ошибок. Пусто — выключены.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
POSTHOG_KEY=
NEXT_PUBLIC_SENTRY_DSN=
# Окружение ошибок сервера в Sentry. Пусто — production. Например, staging для
# пробного сервера. Ошибки из браузера всегда приходят как production.
SENTRY_ENVIRONMENT=
