# Не ставить peer-зависимости автоматически: без флага npm притягивает ~40 лишних
# пакетов (webpack — peer у @sentry/webpack-plugin, типы для livekit-client), а
# сборке на Turbopack они не нужны. package-lock.json собран с этим флагом —
# ставьте с ним же (локально, в Docker и CI).
legacy-peer-deps=true
