{
  "name": "game-room",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/build-audio.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/build-audio.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "stack": "node scripts/dev-stack/start.mjs",
    "stack:fetch": "node scripts/dev-stack/fetch.mjs",
    "smoke": "node scripts/dev-stack/smoke.mjs",
    "e2e": "node e2e/run.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "audio:build": "node scripts/build-audio.mjs",
    "audio:eval": "node scripts/audio-eval/run.mjs",
    "analytics:export": "node --env-file=.env.local scripts/analytics-export.mjs",
    "leads:export": "node --env-file=.env.local scripts/leads-export.mjs",
    "video": "remotion studio",
    "video:render": "remotion render Promo16x9 video-out/game-room-promo-16x9.mp4",
    "video:render:vertical": "remotion render Promo9x16 video-out/game-room-promo-9x16.mp4 && remotion render Teaser9x16 video-out/game-room-teaser-9x16.mp4",
    "video:poster": "remotion still Poster video-out/poster-1200x630.png && remotion still Square video-out/square-1080x1080.png",
    "sounds:pack": "node scripts/sounds-pack.mjs"
  },
  "dependencies": {
    "@livekit/components-react": "^2.9.21",
    "@sapphi-red/web-noise-suppressor": "^0.4.1",
    "@sentry/nextjs": "^10.62.0",
    "@upstash/ratelimit": "^2.0.5",
    "@upstash/redis": "^1.34.3",
    "livekit-client": "^2.19.2",
    "livekit-server-sdk": "^2.15.5",
    "next": "16.2.9",
    "posthog-js": "^1.393.5",
    "posthog-node": "^5.38.5",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "uqr": "0.1.3"
  },
  "devDependencies": {
    "@remotion/cli": "^4.0.532",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "ajv": "^8.20.0",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "playwright-core": "^1.63.0",
    "remotion": "^4.0.532",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.9"
  }
